	if cfg_name == "":
		error_and_exit(f"udon.poll_check() - config empty string: {cfg_name}")

	home_dir = udon.udon_utils.home_dir()
	if home_dir == None:
		error_and_exit("udon.poll_check() - home_dir() returned None")

	cfg_path = udon.channel_cfg_path(cfg_name)
	if not os.path.exists(cfg_path):
		error_and_exit(f"udon.poll_check() - cfg_path not found: {cfg_path}")

	try:
		cfg = udon.udon_utils.toml_to_dict(cfg_path)
	except Exception as e:
