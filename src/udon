def do_read(read_channel: str, read_unread=False):
	"""
		Read messages from local (client-side) DB
	"""
	if not options.msg_num:
		options.msg_num = 3

	if len(sys.argv) == 4:
		n = sys.argv[3]
		if udon_utils.is_int(n):
			options.msg_num = int(n)

	if not udon.udon_utils.is_int(options.msg_num):
		error_and_exit("udon.read() Requested msg number NOT integer")
	num = int(options.msg_num)

	home_dir = udon.udon_utils.home_dir()
	if home_dir == None:
		error_and_exit("udon.read() home_dir() return None")

	cfg_path = udon.channel_cfg_path(read_channel)
	if not os.path.exists(cfg_path):
		error_and_exit(f"udon.read() channel path NOT found: {cfg_path}")

	try:
		cfg = udon.udon_utils.toml_to_dict(cfg_path)
	except Exception as e:
		error_and_exit(f"udon.read() Failed to open config {cfg_path}:{e}")

	client = udon.udon_client()
	if not client.c_load_config(cfg):
		error_and_exit("udon.read() - client.c_load_config() Failed")

	if not udon.udon_DB.channel_table_exists(client.client_db_path, client.channel_name):
		err = f"udon.read() - channel_table_exists({client.channel_name}) False"
		try_sync = "Try: udon --sync <channel>"
		error_and_exit(f"{err}\n{try_sync}")
	channel_name = f"chan_{client.channel_name}"

	# List of lists
	message_lst = client.c_read(channel_name, num, read_unread=read_unread)
	if message_lst == None:
		error_and_exit("do_read() returned Error")

	for msg in message_lst:
		msg = client.c_decrypt_message(msg)

		msg_num = msg[0]
		time    = msg[1]
		verify  = msg[2]
		key     = msg[3]
		channel = msg[4]
		message = msg[5]

		if key in client.hash_to_keyname.keys():
			key = client.hash_to_keyname[key]
			key = key.replace(".pub", "")

		fmtd_out = "".join([f"#{msg_num}: ",
					f"{time}\n",
					f"{verify} ",
					f"{key} ",
					f"[{channel}]\n{message}\n"])
		print(fmtd_out)

		chan = f"chan_{channel}"
		rtn = client.c_mark_msg_as_read(chan, msg_num)
		if rtn != 0:
			error('do_read() - mark_msg_as_read()')
			return None


def get_input():
	"""
		Receive command line input from user.
		Return when 2 consecutive newlines are input
	"""
	A, B, Z = "", "", ""
	while True:
		A = input("> ")
		if A != "" :
			Z = f"{Z}\n{A}"
		else:
			break
		B = input("> ")
		if B == "":
			break
		else:
			Z = f"{Z}\n{B}"

	if Z.startswith("\n"):
		Z = Z[1:]

	""" Note: strings with new lines break signature verification """
	return Z.strip()


def do_commit_message(add_member="", drop_member=""):
	"""
		Run message (send) commit() workflow
	"""
	home_dir = udon.udon_utils.home_dir()
	cfg = None

	path = udon.channel_cfg_path(options.msg_channel)
	if not os.path.exists(path):
		error_and_exit(f"udon.commit_message() - Path not found: {path}")

	try:
		cfg = udon.udon_utils.toml_to_dict(path)
	except Exception as e:
		error_and_exit(f"udon.commit_message() - config.Config() {e}")

	client = udon.udon_client()
	if not client.c_load_config(cfg):
		error_and_exit("udon.commit_message() - c_load_config failure")

	if add_member != "":
		msg = f"Invited {add_member} to channel"
	elif drop_member != "":
		if client.key_name != drop_member:
			error_and_exit("Only users can drop themselves from a channel...")
		msg = f"{drop_member} has left the channel"
	elif options.cli_input:
		msg = options.cli_input
	else:
		msg = get_input()
		if not msg:
			return

	channel_info = client.gen_channel_struct(add_member=add_member, drop_member=drop_member)
	if not channel_info:
		error_and_exit("gen_channel_struct() returned None")

	sent = 0
	total = len(client.recipients)

	print("Sending...")
	for recipient in client.recipients:
		rtn = client.c_send(recipient, msg, channel_info)
		if rtn == True:
			sent = sent + 1
	print(f"Sent:{sent}/{total}")


def do_clean_channel(chan: str):
	"""
		Delete messages from Server table
		This deletes message content only. An empty table row will remain,
		as to not alter message count.
	"""
	home_dir = udon.udon_utils.home_dir()
	cfg = None

	path = udon.channel_cfg_path(chan)
	if not os.path.exists(path):
		error_and_exit(f"udon.clean() - Path not found: {path}")

	try:
		cfg = udon.udon_utils.toml_to_dict(path)
	except Exception as e:
		error_and_exit(f"udon.clean() - config.Config() {e}")

	local_db_path = cfg['client_db_path']
	if not os.path.exists(local_db_path):
		error_and_exit("udon.clean() - client_db_path not found")

	table_name = f"chan_{chan}"
	msg_count = udon.udon_DB.table_row_count(local_db_path, table_name)
	if msg_count == None:
		error_and_exit("udon.clean() - table_row_count() returned None")

	if not udon.udon_utils.is_int(msg_count):
		error_and_exit("udon.clean() - table_row_count return non int")
	msg_count = str(msg_count).encode()

	client = udon.udon_client()
	if not client.c_load_config(cfg):
		error_and_exit("udon.clean() - c_load_config failure")
	client.c_load_config(cfg)

	key_id = client.key_name
	uuid = udon.udon_utils.generate_uuid()
	uuid_sig = client.c_gen_signature(uuid.encode())
	uuid = uuid.encode()

	rsp = client.c_clean(key_id=key_id, buuid_sig=uuid_sig, buuid=uuid,
					  clean_count=msg_count)


def do_list_channels():
	"""
		Output list of channels, message count, and read status.
	"""
	chan_lst = udon.udon_DB.get_channel_list()
	if chan_lst == None:
		error_and_exit("udon_DB.list_channels() - list_channels returned None")

	db_paths = udon.udon_DB.get_client_db_paths(chan_lst)
	if db_paths == None:
		error_and_exit("udon_DB.list_channels() - get_client_db_paths return None")

	print("Channels:")
	for path in db_paths:
		table_lst = udon.udon_DB.get_table_list(path)
		for table in table_lst:
			if "chan_" in table:
				unread_msgs = udon.udon_DB.channel_new_msg_count(path, table)
				if unread_msgs < 0:
					error_and_exit("udon:list_channels() - channel_new_msg_count() returned < 0")

				total = udon.udon_DB.table_row_count(path, table)
				# verify
				chan = table.replace("chan_","").replace(" ","")
				if unread_msgs > 0:
					chan = f"\033[0;32;48m{chan}\033[0m"
				print(f" * {chan}: Unread:{unread_msgs} Total:{total}")


def output_new_messages(client, chan_lst: list):
	"""
		Iterate over channels and output newly arrived messages.
	"""
	for channel_name in chan_lst:
		chan_name = f'chan_{channel_name}'
		if udon.udon_DB.table_exist(client.client_db_path , chan_name):
			do_read(channel_name, read_unread=True)


def do_iter_poll():
	"""
		Iterate over channel configs.
		and poll the server for new messages.
		If new messages exists, sync and print them.
	"""
	print("Waiting for messages...")
	home_dir = udon.udon_utils.home_dir()
	while (True):
		cfg_file_lst = udon.udon_DB.get_channel_list()
		if cfg_file_lst == None:
			error_and_exit("No channels found.\nExiting...")

		for cfg_name in cfg_file_lst:
			cfg_path = udon.channel_cfg_path(cfg_name)
			if not os.path.exists(cfg_path):
				error_and_exit(f"udon.iter_poll() config not found: {cfg_path}")

			try:
				cfg = udon.udon_utils.toml_to_dict(cfg_path)
			except Exception as e:
				error_and_exit(f"udon.iter_poll(): Failed to open config {cfg}")

			client = udon.udon_client()
			if not client.c_load_config(cfg):
				error_and_exit(f"udon.iter_poll() Failed to open config {cfg}")

			if not client.c_ping():
				error_and_exit("No response from server...")

			r = udon.udon_DB.init_primary_table(client.client_db_path, client.key_name)
			if r != 0:
				error_and_exit(f"udon.iter_poll() init_primary_table {cfg}")

			diff = client.c_poll(sync=True, quiet=True, single_batch=True)
			if diff < 0:
				error_and_exit("Error: udon.iter_poll() - poll() return -1")
			if diff > 0:
				chan_lst = udon.udon_DB.get_channel_list()
				output_new_messages(client, chan_lst)
		time.sleep(1)


def do_fetch_key(key_md5: str, channel: str, fetch_key: str):
	"""
		Fetch key from server
	"""
	home_dir = udon.udon_utils.home_dir()
	cfg = None

	types_lst = [
		(key_md5, str),
		(channel, str),
		(fetch_key, str)]
	if not udon.udon_utils.type_check(types_lst):
		error_and_exit("do_fetch_key() - invalid types")

	if len(key_md5) == 16:
		error_and_exit("do_fetch_key() key md5 invalid lenth")
	key_md5 = key_md5.encode()

	path = udon.channel_cfg_path(channel)
	if not os.path.exists(path):
		error_and_exit(f"udon.do_fetch_key() - Path not found: {path}")

	try:
		cfg = udon.udon_utils.toml_to_dict(path)
	except Exception as e:
		error_and_exit(f"udon.do_fetch_key() - config.Config() {e}")

	client = udon.udon_client()
	if not client.c_load_config(cfg):
		error_and_exit("udon.do_fetch_key() - c_load_config failure")

	key_id = client.key_name
	key_id = client.keyname_to_hash[key_id]
	key_id = key_id.encode()

	""" Generate request ID and signature """
	uuid = udon.udon_utils.generate_uuid()
	req_uuid = uuid.encode()
	req_sig = client.c_gen_signature(req_uuid)

	resp = client.c_fetchkey(key_md5, key_id, req_sig, req_uuid)
	if not resp:
		error_and_exit("c_fetchkey() return None")

	resp_err = resp.error.decode("utf-8")
	if resp_err:
		error_and_exit(f"c_fetchkey() {resp_err}")

	rtnd_key = resp.key.decode("utf-8")
	if rtnd_key:
		home = udon.udon_utils.home_dir()
		keypath = f"{home}/.udon/keys/client_side_keys/{fetch_key}"
		try:
			with open(keypath, "w") as FD:
				FD.write(rtnd_key)
		except Exception as e:
			error_and_exit(f"do_fetch_key(): write key to file {e}")

	if os.path.exists(keypath):
		print(f"Key fetched {keypath}")
	else:
		error_and_exit(f"Key ID fetch failed: {key_md5}")


