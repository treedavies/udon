def do_start_server(start_daemon=False):
	home_dir = udon.udon_utils.home_dir()
	if home_dir == None:
		error_and_exit("Error: Platform not identified.")

	cfg = os.path.join(home_dir, udon.UDON_SERVER_CONF)
	if not os.path.exists(cfg):
		print(f"Error: server Config not found: {cfg}")
		error_and_exit("Try running: `udon_init.py --init`")

	srv = udon.udon_server()
	print("Server instantiated")
	print("Starting Server")

	if start_daemon:
		with daemon.DaemonContext():
			srv.s_start_server()
	else:
		srv.s_start_server()


def do_check_sync(channel: str) -> int:
	"""
		Poll server for message count and sync the client's 
		message table with server's Tables if there is a difference.
	"""
	cfg_name = channel

	home_dir = udon.udon_utils.home_dir()
	if not home_dir:
		error_and_exit("udon.check_sync(): home_dir() return None")

	cfg_path = f"{home_dir}/{udon.UDON_CHAN_DIR}/{cfg_name}"
	if not os.path.exists(cfg_path):
		error_and_exit(f"udon.check_sync(): config path not found: {cfg_path}")

	cfg = udon.udon_utils.toml_to_dict(cfg_path)
	client = udon.udon_client()
	if not client.c_load_config(cfg):
		error_and_exit("udon.check_sync(): c_load_config() failed")

	rc = udon.udon_DB.init_primary_table(client.client_db_path, client.key_name)
	if rc != 0:
		error_and_exit("udon.check_sync(): udon_DB.init_primary_table() failed")
	rtn = client.c_poll(sync=True)

	clean_on_sync = client.config['clean_on_sync'].lower()
	if rtn > 0 and clean_on_sync == "enable":
		do_clean_channel(options.sync_channel)
		print(f"clean_on_sync: {clean_on_sync}")
	return rtn


